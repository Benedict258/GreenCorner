# Postgres connection string. Production: Neon, the DIRECT string (no "-pooler" in the host)
DATABASE_URL=postgres://postgres@localhost:5432/gcq

# Session signing secret: at least 32 random characters
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The main owner account (always works, even before any staff are invited).
# Generate the hash with: npm run hash-password (asks for the password at a hidden prompt)
ADMIN_EMAIL=benedict@example.com
ADMIN_PASSWORD_HASH=

# The public address of the store, no trailing slash. Used in emails, Paystack's return address,
# the sitemap and robots.txt. Example: https://store.waste2light.com
SITE_URL=

# Contact shown in the sync User-Agent so Microscale can reach the Waste2Light team
SYNC_CONTACT=https://waste2light.com

# Paystack (Settings > API Keys & Webhooks). Test keys start sk_test_ / pk_test_; live keys sk_live_ / pk_live_.
# Webhook URL to paste in Paystack: <SITE_URL>/api/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email through Resend (resend.com). MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="Waste2Light Store <orders@example.com>"
MAIL_REPLY_TO=info@waste2light.com
# Where team alerts go if Admin > Settings has none (comma separated)
NOTIFY_EMAIL=

# WhatsApp Cloud API (Meta for Developers > WhatsApp). Optional.
# Messages outside a 24-hour chat need an approved template with one body parameter: set its name here.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Team WhatsApp numbers if Admin > Settings has none (comma separated)
NOTIFY_WHATSAPP=

# Local testing only: PG_POOL_MAX=1 for test servers that cannot run queries in parallel (PGlite).
# PG_POOL_MAX=
